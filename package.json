{
    "name": "@getcliqio/cliqhub-bff",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "dev": "tsc --watch & node --env-file=.env --watch dist/server.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "pg": "^8.16.0",
        "uuid": "^11.1.0",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.2",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.11.0",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "@vitest/coverage-v8": "^3.1.3",
        "supertest": "^7.1.0",
        "typescript": "^5.8.3",
        "vitest": "^3.1.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/getcliqio/cliqhub-bff.git"
    }
}
