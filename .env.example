# cliqhub-bff — every variable the BFF reads. Copy to .env and fill in.
# Placeholder values only; never commit real secrets.

# ── Server ──────────────────────────────────────────────────────────────────
# HTTP port (default 3001).
PORT=3001
# development | production | test. production hides internal error messages.
NODE_ENV=development
# Built SPA to serve (production); empty serves the API only.
STATIC_DIR=
# Browser origins allowed by CORS, comma-separated; empty disables CORS
# (same-origin SPA).
CORS_ORIGINS=
# Which proxies may set the client address (req.ip) through X-Forwarded-For.
# Unset/false (default): the socket address — behind a proxy every client
# then shares the proxy's address in per-address limits (e.g. Forgot
# password). Set it to what sits in front of the BFF: a hop count (1), a
# list of addresses/subnets/presets (loopback, 10.0.0.0/8, uniquelocal), or
# true only when nothing can reach the BFF except through the proxy.
TRUST_PROXY=false

# ── Core ────────────────────────────────────────────────────────────────────
# Core API (cliqhub-core) the BFF calls. Required.
BACKEND_URL=http://localhost:4000
# Optional override of BACKEND_URL for the Core client (split-stack debugging).
CORE_API_URL=

# ── Sessions ────────────────────────────────────────────────────────────────
# The BFF's own session database. Required. Locally: the same Postgres as
# cliqhub-core (sessions live in schema `bff`). Never a shared cloud database —
# the BFF refuses *.proxy.rlwy.net unless BFF_ALLOW_SHARED_SESSION_DB=1.
DATABASE_URL=postgresql://cliqhub:cliqhub@localhost:5432/cliqhub
# Set to 1 to allow a shared Railway database on purpose.
BFF_ALLOW_SHARED_SESSION_DB=
# Signs the session cookie. Required; use a long random value.
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=cliqhub_sid
# Session lifetime and idle timeout, in seconds (defaults 30 days / 2 hours).
SESSION_TTL_SECONDS=2592000
SESSION_IDLE_SECONDS=7200

# ── Builder (LLM) rate limits ───────────────────────────────────────────────
# Requests per window per address + user + path: anonymous / signed in.
RATE_LIMIT_BUILDER_ANON=5
RATE_LIMIT_BUILDER_AUTH=30
RATE_LIMIT_WINDOW_MS=60000

# ── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error | fatal (default info). CLIQ_BFF_LOG_LEVEL wins
# over LOG_LEVEL.
CLIQ_BFF_LOG_LEVEL=
LOG_LEVEL=
